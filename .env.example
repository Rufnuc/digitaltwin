# ---------------------------------------------------------------------------
# DigitalTwin — environment configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development           # development | staging | production
API_V1_PREFIX=/api/v1
PROJECT_NAME=DigitalTwin

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
# App (Postgres, via docker compose). Async tests fall back to sqlite automatically.
DATABASE_URL=postgresql+psycopg://digitaltwin:digitaltwin@localhost:5432/digitaltwin
# To run off your PC, use a managed cloud Postgres (Neon/Supabase/etc). Keep the
# '+psycopg' driver tag and add '?sslmode=require'. See docs/database_hosting_plan.md
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_USER=digitaltwin
POSTGRES_PASSWORD=digitaltwin
POSTGRES_DB=digitaltwin
POSTGRES_PORT=5432

# --- Redis / background workers (interface only in Phase 1) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage abstraction (S3-compatible; local FS driver in Phase 1) ---
STORAGE_DRIVER=local              # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI assistant (Phase 4) ---
# rule_based = offline deterministic router (default, no key). anthropic = real LLM.
AI_PROVIDER=rule_based           # rule_based (offline) | ollama (local LLM) | anthropic
AI_API_KEY=                       # required only when AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OCR / Document AI (Phase 5) ---
OCR_PROVIDER=structured_json     # structured_json (offline) | google_document_ai | aws_textract | azure
OCR_API_KEY=

# --- Market data abstraction (NOT used in Phase 1) ---
MARKET_DATA_PROVIDER=live         # live (real World Bank + FX + Google News) | none
MARKET_DATA_API_KEY=

# --- Shipping monitor (aisstream.io live AIS vessel data) ---
# Get a free key at https://aisstream.io ; leave blank to disable shipping.
AISSTREAM_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
