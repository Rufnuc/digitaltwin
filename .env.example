# ---------------------------------------------------------------------------
# DigitalTwin — environment configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development           # development | staging | production
API_V1_PREFIX=/api/v1
PROJECT_NAME=DigitalTwin

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
# App (Postgres, via docker compose). Async tests fall back to sqlite automatically.
DATABASE_URL=postgresql+psycopg://digitaltwin:digitaltwin@localhost:5432/digitaltwin
POSTGRES_USER=digitaltwin
POSTGRES_PASSWORD=digitaltwin
POSTGRES_DB=digitaltwin
POSTGRES_PORT=5432

# --- Redis / background workers (interface only in Phase 1) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage abstraction (S3-compatible; local FS driver in Phase 1) ---
STORAGE_DRIVER=local              # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI provider abstraction (NOT used in Phase 1) ---
AI_PROVIDER=none                  # none | anthropic | openai | ...
AI_API_KEY=

# --- OCR / Document AI abstraction (NOT used in Phase 1) ---
OCR_PROVIDER=none                 # none | google_document_ai | aws_textract | azure | ...
OCR_API_KEY=

# --- Market data abstraction (NOT used in Phase 1) ---
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
